# Core Server Settings
PORT=9900
SPRING_PROFILES_ACTIVE=local

# Database Connection (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/postgres?sslmode=disable&connectTimeout=10&socketTimeout=30
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_password

# Authentication (JWT)
JWT_SECRET=replace_with_secure_signing_secret_key_of_32_bytes_or_more
JWT_EXPIRATION=86400000

# Base URLs (Used for dynamic generation of Redirect URLs, Callbacks, and CORS)
FRONTEND_URL=http://localhost:3000

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=cbp.notification@gmail.com
API_BASE_URL=http://localhost:9900

# PhonePe Integration Credentials
PHONEPE_CLIENT_ID=your_phonepe_client_id
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret
PHONEPE_CLIENT_VERSION=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com

# Optional Overrides (Use only if endpoints differ from standard derived paths)
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# PHONEPE_REDIRECT_URL=http://localhost:3000/payment-status
# PHONEPE_CALLBACK_URL=http://localhost:9900/api/v1/payment/phonepe/callback
